# Mommy Care - environment variables
# Copy to .env for local development. Never commit real secrets.

# PostgreSQL connection string (Railway injects this automatically in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mommy

# Manager access code. Server-side only - never shipped to the browser.
MANAGER_SECRET=change-me

# Secret used to sign session cookies. Use a long random string.
SESSION_SECRET=change-me-too

# Optional: require a shared code before the read-only team view loads data.
# Leave unset/empty for an open (link-only) team view, matching the prototype.
TEAM_ACCESS_CODE=

# IANA timezone used for week boundaries and "today".
APP_TIMEZONE=Asia/Jerusalem

# HTTP port (Railway sets this automatically).
PORT=8080
